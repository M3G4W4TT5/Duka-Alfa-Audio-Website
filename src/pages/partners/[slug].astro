---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import Button from "../../components/ui/Button.astro";
import { partners } from "../../lib/content";
import type { Partner } from "../../data/types";
import "../../styles/partner-page.css";
export function getStaticPaths() {
  return partners.map((partner) => ({
    params: { slug: partner.slug },
    props: { partner },
  }));
}
interface Props {
  partner: Partner;
}
const { partner } = Astro.props;
---

<SiteLayout title={partner.name}
  ><PageIntro title={partner.name} compact class="partner-page-intro"
    ><img
      class="partner-page-logo"
      src={partner.logo}
      alt={partner.name}
      width="300"
      height="150"
    /></PageIntro
  ><section class="partner-page-content section wrap">
    <p class="prose muted">
      {
        partner.description
          ? partner.description
          : `Talk to us about ${partner.name} and the right equipment for your project.`
      }
    </p>{
      partner.slug !== "tt-audio" && (
        <p class="review-note muted">
          Detailed brand information and our work together will be added in the
          next content pass.
        </p>
      )
    }<Button href="/contact/" label="Get in Touch" />
  </section></SiteLayout
>
