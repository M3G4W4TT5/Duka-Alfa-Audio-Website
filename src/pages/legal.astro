---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageIntro from "../components/ui/PageIntro.astro";
---

<SiteLayout title="Legal Information"
  ><PageIntro
    title="Legal Information"
    eyebrow="Review Draft"
    intro="This website is a design review for Duka Alfa Audio. It is not an online shop or booking service."
  /><section class="section wrap">
    <div class="prose">
      <h2>Website content</h2><p>
        Copy and selected imagery are being reviewed. Equipment examples do not
        constitute an offer, guarantee availability or reserve equipment.
        Project-specific requirements and terms are agreed separately.
      </p><h2>Images and brand names</h2><p>
        Brand names and logos belong to their respective owners. Third-party
        product images are used to identify the equipment shown. Final image
        credits and permissions must be completed before launch.
      </p><h2>Business identification</h2><p>
        The final page will include the approved legal business name, registered
        address, registration details and public contact information. Applicable
        terms and jurisdiction-specific requirements remain to be reviewed.
      </p>
    </div>
  </section></SiteLayout
>
