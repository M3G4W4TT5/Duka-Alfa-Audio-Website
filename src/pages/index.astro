---
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/home/Hero";
import AboutIntro from "../components/home/AboutIntro.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import StoriesCarousel from "../components/home/StoriesCarousel";
import Equipment from "../components/home/Equipment.astro";
import Partners from "../components/home/Partners.astro";
import Contact from "../components/home/Contact.astro";
import Button from "../components/ui/Button.astro";
import { heroSlides, services, site, stories } from "../lib/content";
import { browserPhoto } from "../lib/images";
import "../styles/home.css";
const slides = await Promise.all(
  heroSlides.map(async (slide) => ({
    ...(await browserPhoto(slide)),
    id: slide.id,
    durationMs: slide.durationMs,
  })),
);
const storySlides = await Promise.all(
  stories.map(async (story) => ({
    slug: story.slug,
    title: story.title,
    tags: story.tags,
    photo: await browserPhoto(story.photo),
  })),
);
---

<SiteLayout home>
  <Hero
    slides={slides}
    title={site.heroTitle}
    message={site.heroMessage}
    intervalMs={site.heroIntervalMs}
    client:load
  />
  <AboutIntro />
  <section class="section wrap" id="services" aria-labelledby="services-title">
    <div class="section-heading">
      <h2 id="services-title">Our Services</h2>
    </div>
    <div class="services-grid">
      {
        services
          .filter((service) => !service.parent)
          .map((service) => <ServiceCard service={service} />)
      }
    </div>
  </section>
  {
    storySlides.length > 0 && (
      <section
        class="stories-section"
        id="stories"
        aria-labelledby="stories-title"
      >
        <>
          <div class="section-heading wrap">
            <>
              <h2 id="stories-title">Selected Stories</h2>
            </>
          </div>
          <StoriesCarousel
            stories={storySlides}
            client:visible={{ rootMargin: "600px" }}
          />
          <div class="stories-more center">
            <Button href="/stories/" label="More Stories" />
          </div>
        </>
      </section>
    )
  }
  <Equipment />
  <Partners />
  <Contact />
</SiteLayout>
