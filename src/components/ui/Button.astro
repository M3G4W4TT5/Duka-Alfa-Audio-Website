---
import { ArrowUpRight } from "lucide-react";
interface Props {
  href: string;
  label: string;
  arrow?: boolean;
}
const { href, label, arrow = false } = Astro.props;
---

<a class="menu__link" href={href}
  >{label}{
    arrow && (
      <ArrowUpRight className="icon" size=20 aria-hidden="true" />
    )
  }</a
>
