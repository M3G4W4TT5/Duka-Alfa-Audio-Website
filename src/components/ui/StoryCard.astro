---
import type { Story } from "../../data/types";
import Photo from "../media/Photo.astro";
import "./story-card.css";
import "./card-edge.css";
interface Props {
  story: Story;
}
const { story } = Astro.props;
---

<article class="story-card">
  <a class="card-edge" href={`/stories/${story.slug}/`}
    ><div class="story-card-photo">
      <Photo photo={story.photo} sizes="(min-width: 700px) 50vw, 100vw" />
    </div><div class="story-card-copy">
      <p class="eyebrow muted">{story.tags.join(" · ")}</p><h2>
        {story.title}
      </h2><p class="muted">{story.introduction}</p>
    </div></a
  >
</article>
